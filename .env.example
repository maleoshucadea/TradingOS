# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DERIV_CLIENT_ID: Registered Deriv OAuth 2.0 Client ID from https://developers.deriv.com
# Required for Deriv OAuth 2.0 Authorization Code + PKCE flow.
# Do NOT use legacy App ID 1089 here.
DERIV_CLIENT_ID=

# DERIV_APP_ID: Deriv WebSocket API application ID for public market quotes and symbols catalog.
# Defaults to 1089 for public sandbox market streams.
DERIV_APP_ID="1089"

# DERIV_OAUTH_REDIRECT_URI: (Optional) Exact redirect URI registered in Deriv OAuth app settings.
# Must match between authorization request and token exchange.
# Defaults to ${APP_URL}/auth/deriv/callback
DERIV_OAUTH_REDIRECT_URI=

# DERIV_OAUTH_SCOPE: (Optional) OAuth 2.0 permission scope.
# Deriv OAuth 2.0 scopes: trade, account_manage, application_read, payment.
# Defaults to 'trade' for trading account telemetry and portfolio/positions read.
DERIV_OAUTH_SCOPE="trade"

# DERIV_API_TOKEN: (Optional) Read-only Deriv Demo API token.
# Generate from Deriv -> Account Settings -> API Token with 'Read' scope only.
DERIV_API_TOKEN=

# CTRADER_CLIENT_ID: Registered cTrader Open API Client ID from https://openapi.ctrader.com
CTRADER_CLIENT_ID=

# CTRADER_CLIENT_SECRET: Registered cTrader Open API Client Secret (Keep secret on server, NEVER expose to client)
CTRADER_CLIENT_SECRET=

# CTRADER_REDIRECT_URI: Exact redirect URI registered in cTrader Open API app settings
# Defaults to https://tradingos-1.onrender.com/auth/ctrader/callback (or ${APP_URL}/auth/ctrader/callback)
CTRADER_REDIRECT_URI=
